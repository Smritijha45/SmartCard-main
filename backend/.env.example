# ==========================================
# SmartCard Global Env Variables Template
# ==========================================

# Environment & Ports
NODE_ENV=development
PORT=5000
FRONTEND_PORT=3000
BACKEND_PORT=5000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Mongoose Database URI
MONGO_URI=mongodb://localhost:27017/smartcard-saas

# Redis Cache URL
REDIS_URI=redis://localhost:6379

# Cryptography (JWT Token keys)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay Indian Payment Gateway Credentials (Test Mode supported)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Storage Upload Provider (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Dispatch
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@smartcard.app

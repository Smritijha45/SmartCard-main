# ==========================================
# SmartCard Global Env Variables Template
# ==========================================

# Ports & Hosts
FRONTEND_PORT=3000
BACKEND_PORT=5000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Mongoose Database URI
MONGO_URI=mongodb://localhost:27017/smartcard-saas

# Redis Cache URL
REDIS_URI=redis://localhost:6379

# Cryptography (JWT Token keys)
JWT_ACCESS_SECRET=your_access_token_secret_key_placeholder
JWT_REFRESH_SECRET=your_refresh_token_secret_key_placeholder

# Storage Upload Provider (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Dispatch
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
